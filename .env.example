VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server only: required for AI, payments, deletion and shared rate limits.
# Never put these values in VITE_ variables or commit populated credentials.
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CRON_SECRET=

# Server only: optional remote notification transport. Never use VITE_ for these.
FCM_SERVICE_ACCOUNT_JSON=
APNS_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.healthchain.app
APNS_ENVIRONMENT=production

# Server only. Alternatively grant healthchain_admin=true in server-controlled
# Supabase app_metadata. Never use user_metadata for content administration.
CONTENT_ADMIN_USER_IDS=

# Native store setup: leave disabled until products, notifications, migration,
# sandbox refunds/restoration and signed-device checks have passed.
# These are SERVER ONLY. Never put keys in VITE_ variables.
STORE_ACCOUNT_TOKEN_SECRET=
APPLE_STORE_ENABLED=false
APPLE_STORE_PRIVATE_KEY=
APPLE_STORE_KEY_ID=
APPLE_STORE_ISSUER_ID=
APPLE_STORE_APP_ID=
APPLE_STORE_ENVIRONMENT=Production
APPLE_STORE_NOTIFICATIONS_VERIFIED=false
GOOGLE_STORE_ENABLED=false
GOOGLE_STORE_SERVICE_ACCOUNT_JSON=
GOOGLE_STORE_PUBSUB_AUDIENCE=
GOOGLE_STORE_PUBSUB_EMAIL=
GOOGLE_STORE_ALLOW_TEST=false
GOOGLE_STORE_NOTIFICATIONS_VERIFIED=false

# Server-only Sign in with Apple token revocation (separate from StoreKit keys).
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
