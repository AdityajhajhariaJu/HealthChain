VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server only: optional remote notification transport. Never use VITE_ for these.
FCM_SERVICE_ACCOUNT_JSON=
APNS_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.healthchain.app
APNS_ENVIRONMENT=production

# Server only. Alternatively grant healthchain_admin=true in server-controlled
# Supabase app_metadata. Never use user_metadata for content administration.
CONTENT_ADMIN_USER_IDS=
